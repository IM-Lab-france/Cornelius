+        satellite.last_send_ms=(uint32_t)took_ms;
+        if ((uint32_t)took_ms>satellite.max_send_ms) satellite.max_send_ms=(uint32_t)took_ms;
+        if (sent<0) satellite.send_failures++;
+        if (took_ms>250) satellite.slow_sends++;
