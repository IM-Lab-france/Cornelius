+bool link_camera_frame(const char *id, const uint8_t *jpeg, size_t length) {
+    if (!client || !satellite.online || satellite.muted || length>80000) return false;
+    uint8_t *packet=heap_caps_malloc(length+37,MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT);
+    if (!packet) return false;
+    packet[0]=0x4a; memcpy(packet+1,id,36); memcpy(packet+37,jpeg,length);
+    int sent=esp_websocket_client_send_bin(client,(const char *)packet,length+37,pdMS_TO_TICKS(5000));
+    free(packet);
+    return sent==(int)(length+37);
+}
+void link_camera_error(const char *id) {
+    cJSON *msg=cJSON_CreateObject();
+    cJSON_AddStringToObject(msg,"type","camera_error");
+    cJSON_AddStringToObject(msg,"requestId",id);
+    send_json(msg);
+}
+
